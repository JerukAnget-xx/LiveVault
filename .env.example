# PostgreSQL only. Do not commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Generate a high-entropy value with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Server-only Supabase Storage access. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_REPORT_SCREENSHOTS_BUCKET="report-screenshots"

# Optional server-only Meta WhatsApp Cloud API configuration.
# Leave all six unset until WhatsApp is ready, then configure all six together.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=
# WHATSAPP_GRAPH_VERSION=

# Random server-only token used by Meta to verify the webhook callback URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-webhook-verify-token"
